{
  "name": "mtmdsh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check --write .",
    "check": "turbo run //#format-and-lint build typecheck test",
    "release": "pnpm check && PNPM_CONFIG_PROVENANCE=true changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/cli": "3.0.2",
    "turbo": "2.10.12"
  }
}
