{
  "name": "mtmharness",
  "version": "0.3.1",
  "description": "DeepSeek Harness Web plugin with unified MTM, Canvas, Connect, and independent static/embed client.",
  "type": "module",
  "engines": { "node": ">=22.19.0", "pnpm": ">=11.7.0" },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "unpkg": "./dist/embed/mtmharness.iife.js",
  "jsdelivr": "./dist/embed/mtmharness.iife.js",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./embed": { "types": "./dist/types/standalone/index.d.ts", "import": "./dist/embed/mtmharness.js", "default": "./dist/embed/mtmharness.js" },
    "./app": "./dist/standalone/index.html",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "dist/standalone",
    "dist/embed",
    "dist/types/standalone",
    "cordis.patch.yml",
    "scripts/profile-migration.mjs",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config vite.standalone.config.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.standalone.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify:package",
    "pack:check": "node scripts/pack-check.mjs",
    "profile:check": "node scripts/profile-migration.mjs",
    "prepack": "pnpm run build && pnpm run verify:package"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/codeh007/mtmdsh.git", "directory": "packages/mtmharness" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "react": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.169.2",
    "@types/node": "22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "lucide-react": "1.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
