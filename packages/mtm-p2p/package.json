{
  "name": "mtm-p2p",
  "version": "0.1.0",
  "description": "Minimal browser P2P facade for mtmharness.",
  "type": "module",
  "main": "./lib/client.js",
  "types": "./lib/types/client.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/client.d.ts",
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./worker": "./lib/worker.js",
    "./package.json": "./package.json"
  },
  "mtmharness": {
    "secondary": {
      "id": "mtm-p2p",
      "apiVersion": 1,
      "client": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/crypto": "^5.1.23",
    "@libp2p/websockets": "^10.1.21",
    "libp2p": "^3.3.11"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
